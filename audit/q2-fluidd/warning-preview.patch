@@ -376,0 +388,34 @@ export default class QidiBoxCard extends Mixins(StateMixin, QidiBoxMixin) {
+  rfidVerification: RfidVerification[] = []
+
+  get rfidSamples (): RfidSample[] {
+    if (!this.klippyReady) return []
+    const printer = this.$typedState.printer.printer as typeof this.$typedState.printer.printer & {
+      inventory_rfid_read_guard?: { version: string; last_scans?: Record<string, RfidScan> };
+    }
+    const guard = printer.inventory_rfid_read_guard
+    const box = printer.multi_color_controller?.box as Record<string, unknown> | undefined
+    const variables = printer.save_variables?.variables
+    if (guard?.version !== 'q2-read-guard-v2' || !box || !variables) return []
+
+    return Array.from({ length: this.boxCount * 4 }, (_, index) => {
+      const unit = Math.floor(index / 4)
+      return {
+        printer: 'ready',
+        box_online: box[`box${unit}_is_online`],
+        box_inserted: box[`box${unit}_box_inserted_${index % 4}`],
+        saved_id: variables[`filament_slot${index}`],
+        last_scan: guard.last_scans?.[`slot${index}`]
+      }
+    })
+  }
+
+  get unverifiedSlots (): string[] {
+    return this.rfidVerification.flatMap((slot, index) =>
+      slot.unverified ? [qidiBoxSlotLabel(index)] : [])
+  }
+
+  @Watch('rfidSamples', { immediate: true })
+  onRfidSamplesChanged (samples: RfidSample[]) {
+    this.rfidVerification = samples.map((sample, index) =>
+      updateVerification(this.rfidVerification[index], sample))
+  }
